# SpeechScribe Docker Environment Configuration

# GPU Configuration
# GPU device ID to use (0 for first GPU, comma-separated for multiple)
CUDA_VISIBLE_DEVICES=0

# Python Environment
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# API Configuration
# FastAPI server port
API_PORT=8000
# API host binding
API_HOST=0.0.0.0

# UI Configuration
# Frontend port
UI_PORT=3000
# API endpoint for UI (adjust if deploying to different host)
REACT_APP_API_URL=http://localhost:8000
# React environment
NODE_ENV=production

# Ollama Configuration
# Ollama service URL for API
OLLAMA_HOST=http://ollama:11434
# Ollama port
OLLAMA_PORT=11434
# Default model to use
OLLAMA_DEFAULT_MODEL=qwen2.5

# Speech Models Configuration
# Whisper model size (tiny, base, small, medium, large-v2, large-v3)
WHISPER_MODEL=base
# Use CUDA for Whisper
WHISPER_DEVICE=cuda

# TTS Configuration
# Default TTS model
TTS_MODEL=speecht5

# Service Restart Policy
# Restart policy: no, always, unless-stopped, on-failure
RESTART_POLICY=unless-stopped

# Logging
# Log level for API (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# Nginx log level (error, warn, info, notice, debug)
NGINX_LOG_LEVEL=warn

# Storage Volumes
# Volume mount paths
MODELS_VOLUME_PATH=./docker/models
PLUGINS_VOLUME_PATH=./docker/plugins
CACHE_VOLUME_PATH=./docker/cache
OLLAMA_MODELS_VOLUME_PATH=./docker/ollama-models

# Advanced Settings
# Connection pool size for API
API_WORKERS=4
# Maximum request body size (in MB)
CLIENT_MAX_BODY_SIZE=100

# Security
# Enable CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost"]
# API key for authentication (optional)
# API_KEY=your-secret-key-here

# Database (if using)
# DATABASE_URL=sqlite:///./app.db

# Disable this in production
# DEBUG=True
